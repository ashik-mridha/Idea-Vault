# Base URL of the IdeaVault API (ideaVault-server), without a trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: point the client at a local Firebase Auth emulator, e.g. http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Optional public contact details shown in the footer and on the contact page.
# Anything left empty is simply not displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/ashik90998/ideaVault
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
